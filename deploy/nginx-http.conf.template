# Queue Live reverse proxy, HTTP only. Use when no domain/TLS is available: QUIZ_HOST is the VPS IP.
# Plain HTTP sends bearer tokens unencrypted; restrict port 80 to the class network (see README).
upstream quiz_app {
  server quiz:5174;
  keepalive 16;
}

server {
  listen 80;
  server_name ${QUIZ_HOST};

  client_max_body_size 8k;

  location / {
    proxy_pass http://quiz_app;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    # $http_host keeps the client's port; QUIZ_HOSTS must list the Host exactly as the browser sends it.
    proxy_set_header Host $http_host;
    # Appended by nginx: the app reads only the last entry, which nginx wrote from the real socket address.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # SSE must reach the browser as it is written; the app also sends X-Accel-Buffering: no.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }
}
