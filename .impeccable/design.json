      "css": ".ds-secondary{font-family:Ubuntu,'Segoe UI',sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:5px;border:1px solid #d4dbea;background:var(--white,#fff);color:var(--indigo,#2f39a9);font-size:11px;padding:9px 11px;border-radius:7px;white-space:nowrap;min-height:36px;cursor:pointer;transition:background 160ms,color 160ms,transform 140ms cubic-bezier(.16,1,.3,1),box-shadow 160ms}.ds-secondary svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}@media(hover:hover) and (pointer:fine){.ds-secondary:hover{background:var(--pale,#eef0fc);border-color:#bdc7ed}}@media(max-width:540px){.ds-secondary{min-height:40px}}.ds-primary:focus-visible,.ds-secondary:focus-visible{outline:3px solid var(--blue,#2e6fa0);outline-offset:4px}.ds-primary:active:not(:disabled),.ds-secondary:active:not(:disabled){transform:scale(.97)}.ds-primary:disabled,.ds-secondary:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary{transition:none}}"
