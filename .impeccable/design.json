      "css": ".ds-badge{font-family:Ubuntu,'Segoe UI',sans-serif;display:inline-block;color:var(--indigo,#2f39a9);background:var(--pale,#eef0fc);padding:3px 7px;border-radius:4px;font-size:9px;margin-right:6px}.ds-complete{background:#dbfaf2;color:var(--teal-ink,#087c69)}"
    },
    {
      "name": "Panel operator",
      "kind": "card",
      "refersTo": "panel",
      "description": "Permukaan putih dengan batas silver dan ambient shadow.",
      "html": "<section class=\"ds-panel\"><header class=\"ds-heading\"><strong>Kontrol arena</strong><span>06</span></header><div class=\"ds-content\">Pilih rak, lalu coba push atau pop.</div></section>",
      "css": ".ds-panel{font-family:Ubuntu,'Segoe UI',sans-serif;background:var(--white,#fff);border:1px solid var(--line,#e0e4ee);border-radius:15px;overflow:hidden;box-shadow:var(--shadow,0 8px 30px #29345a08);color:var(--ink,#222944)}.ds-heading{display:flex;align-items:center;gap:9px;padding:16px 20px;border-bottom:1px solid var(--line,#e0e4ee)}.ds-heading strong{font-size:13px;font-weight:500}.ds-heading span{margin-left:auto;font-family:Consolas,monospace;color:var(--muted,#606b85);font-size:10px;border:1px solid var(--line,#e0e4ee);border-radius:4px;padding:2px 6px}.ds-content{padding:18px 20px;font-size:11px;color:var(--muted,#606b85)}"
    },
    {
      "name": "Node linked-list",
      "kind": "custom",
      "refersTo": "linked-node",
      "description": "Data, next, dan pointer eksplisit; permukaan pilihan cyan.",
      "html": "<div class=\"ds-nodes\"><div class=\"ds-node ds-selected\"><span class=\"ds-pointer\">top</span><span class=\"ds-data\">D</span><span class=\"ds-next\">next</span></div><span class=\"ds-arrow\">→</span><div class=\"ds-node\"><span class=\"ds-data\">C</span><span class=\"ds-next\">next</span></div><span class=\"ds-arrow\">→</span><span class=\"ds-null\">None</span></div>",
      "css": ".ds-nodes{display:flex;align-items:center;padding:27px 2px 15px;overflow:auto}.ds-node{flex-shrink:0;position:relative;display:flex;border:1px solid #ccd3ed;border-radius:7px;background:#f0f2fc;transition:border-color 160ms,background 160ms}.ds-node.ds-selected{border-color:var(--cyan,#49a4bb);background:#e7f8f8}.ds-data{padding:12px 15px;font-family:Consolas,monospace;font-size:13px;color:var(--indigo,#2f39a9)}.ds-next{padding:12px 9px;border-left:1px solid #ccd3ed;color:#62749a;font-family:Consolas,monospace;font-size:11px}.ds-pointer{position:absolute;top:-23px;left:0;font-family:Consolas,monospace;font-size:10px;color:var(--blue,#2e6fa0);white-space:nowrap}.ds-arrow{flex-shrink:0;color:#6b85ab;padding:0 8px;font-size:16px}.ds-null{font-family:Consolas,monospace;color:var(--muted,#606b85);font-size:11px}@media(prefers-reduced-motion:reduce){.ds-node{transition:none}}"
    }
  ],
  "narrative": {
    "northStar": "Arena Isometrik Putih–Silver",
    "overview": "Strukdat Gaming menempatkan tindakan belajar dalam arena isometrik terang: kotak modular biru, jalur pasien, permukaan putih–silver, dan penanda turquoise. Karakternya modern, bersih, dan agak futuristik sesuai arahan pengguna. Bentuk dunia berasal dari SVG yang digambar khusus; antarmuka memakai permukaan tenang, garis tipis, dan kontrol yang langsung dapat digunakan.\n\nGerak menjelaskan perpindahan objek dan perubahan perhatian. Animasi selesai setelah tindakan; kamera dapat diperbesar atau difokuskan ke pilihan. Diagram linked-list dan jejak Python memberi lapisan inspeksi yang menjaga kebenaran referensi. Tindakan langsung memiliki alternatif tombol, keyboard, dan gerakan minimal.",
    "keyCharacteristics": [
      "Arena SVG isometrik dengan objek modular yang dapat dipilih.",
      "Dasar putih–silver dengan aksen indigo, biru, cyan, dan turquoise.",
      "Tipografi Ubuntu lokal dan kode monospace.",
      "Gerakan singkat, berhingga, dan terkait tindakan.",
      "Status terbaca melalui label, diagram referensi, dan umpan balik."
    ],
    "rules": [
      {
        "name": "The Light Arena Rule",
        "body": "Pertahankan dasar putih–silver dan gunakan warna aksen untuk objek, tindakan, pilihan, serta referensi.",
        "section": "colors"
      },
      {
        "name": "The Explain Motion Rule",
        "body": "Gerak mengikuti tindakan atau perubahan perhatian, selesai dalam satu rangkaian, dan dapat diminimalkan.",
        "section": "components"
      },
      {
        "name": "The Linked Truth Rule",
        "body": "Diagram dan label mempertahankan arah top, front, rear, dan next yang benar; gerak visual tidak mengubah arti referensi.",
        "section": "components"
      }
    ],
    "dos": [
      "Do pertahankan dasar putih–silver dan empat warna aksen yang ditetapkan pengguna.",
      "Do gunakan indigo untuk tindakan, turquoise untuk penanda pilihan, dan label untuk menjelaskan status.",
      "Do hubungkan objek dunia, node, dan snapshot kode melalui identitas data yang sama.",
      "Do sediakan tombol serta keyboard untuk tindakan langsung dan hormati gerakan minimal.",
      "Do tempatkan operasi cepat dekat arena pada layar sempit dan biarkan form lengkap berada di kontrol operator.",
      "Do gunakan SVG yang digambar khusus dan font lokal untuk menjaga bentuk dunia."
    ],
    "donts": [
      "Don't mengganti dasar putih–silver dengan permukaan gelap sebagai identitas utama.",
      "Don't memakai gerak berulang sebagai dekorasi arena.",
      "Don't mengubah arah panah linked-list demi komposisi dunia.",
      "Don't menggunakan turquoise terang untuk teks informasi utama tanpa pasangan teks gelap.",
      "Don't menggambarkan jejak Python sebagai interpreter atau animasi langkah model yang belum tersedia."
    ]
  }
}
