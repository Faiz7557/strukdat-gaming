      "name": "Tombol utama",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Operasi tambah data beraksen indigo.",
      "html": "<button class=\"ds-primary\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>Simpan / push</button>",
      "css": ".ds-primary{font-family:Ubuntu,'Segoe UI',sans-serif;border:1px solid var(--indigo,#2f39a9);background:var(--indigo,#2f39a9);color:var(--white,#fff);border-radius:7px;padding:11px 10px;font-size:12px;font-weight:500;display:flex;align-items:center;justify-content:center;gap:6px;min-height:40px;box-shadow:0 4px 9px #2f39a911;cursor:pointer;transition:background 160ms,color 160ms,transform 140ms cubic-bezier(.16,1,.3,1),box-shadow 160ms}.ds-primary svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}@media(hover:hover) and (pointer:fine){.ds-primary:hover{background:#252f92;box-shadow:0 5px 12px #2f39a91d}}.ds-primary:focus-visible,.ds-secondary:focus-visible{outline:3px solid var(--blue,#2e6fa0);outline-offset:4px}.ds-primary:active:not(:disabled),.ds-secondary:active:not(:disabled){transform:scale(.97)}.ds-primary:disabled,.ds-secondary:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-primary,.ds-secondary{transition:none}}"
    },
    {
      "name": "Tombol pendamping",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Operasi inspect dan tindakan pendamping.",
