      "css": ".ds-room{display:flex;gap:4px;padding:4px;border:1px solid var(--line,#e0e4ee);border-radius:10px;background:#f7f8fb}.ds-room button{font-family:Ubuntu,'Segoe UI',sans-serif;background:transparent;border:0;color:var(--muted,#606b85);padding:10px 19px;border-radius:7px;font-size:12px;font-weight:500;white-space:nowrap;cursor:pointer;transition:background 160ms,color 160ms,transform 140ms cubic-bezier(.16,1,.3,1)}.ds-room button.ds-active{background:var(--indigo,#2f39a9);color:white;box-shadow:0 3px 8px #2f39a918}.ds-room button:focus-visible{outline:3px solid var(--blue,#2e6fa0);outline-offset:4px}.ds-room button:active{transform:scale(.97)}@media(max-width:900px){.ds-room{width:100%}.ds-room button{flex:1}}@media(max-width:540px){.ds-room button{font-size:11px;padding:9px 6px}}"
