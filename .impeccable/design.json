      "css": ".ds-field{font-family:Ubuntu,'Segoe UI',sans-serif;display:flex;flex-direction:column;gap:5px;font-size:11px;color:var(--muted,#606b85)}.ds-field input{font-family:Ubuntu,'Segoe UI',sans-serif;width:100%;border:1px solid #d9deea;background:#fafbfe;border-radius:6px;color:var(--ink,#222944);padding:9px 10px;font-size:12px;height:37px;caret-color:var(--indigo,#2f39a9);transition:border-color 160ms,box-shadow 160ms}.ds-field input::placeholder{color:var(--muted,#606b85)}.ds-field input:focus{border-color:var(--indigo,#2f39a9);box-shadow:0 0 0 3px #2f39a90b}.ds-field input:focus-visible{outline:3px solid var(--blue,#2e6fa0);outline-offset:4px}@media(max-width:540px){.ds-field input{font-size:16px;height:40px}}"
